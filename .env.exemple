# Modele de configuration. Copier en .env puis remplacer les valeurs.
# Ce fichier-ci est versionne : il ne doit contenir AUCUN vrai mot de passe.

# Numero du groupe (1 a 8) : fixe le sous-reseau 192.168.(55+G).0/24
GROUPE=7

# Base de donnees de l'application
DB_NOM=resultats
DB_UTILISATEUR=app_resultats
DB_MOT_DE_PASSE=a_remplacer

# Compte utilise par bdd2 pour recopier bdd1 (replication)
REPLIC_UTILISATEUR=replicateur
REPLIC_MOT_DE_PASSE=a_remplacer
# Extension E1 : repartiteur redondant lb2 + IP virtuelle 192.168.(55+G).10
# 1 = activee (6 VM), 0 = desactivee (5 VM, socle seul)
AVEC_LB2=0